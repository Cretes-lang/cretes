struct Point {
    pub x: i64,
    pub y: i64,
}

enum State {
    Idle,
    At(Point),
}

type Count = i64;

fn main() -> i32 {
    let point = new Point { x: 3, y: 4 };
    let state = State::At(point);
    match state {
        State::Idle() => { return 0; }
        State::At(p) => {
            discard(p.x + p.y, "Inspect record payload");
            return 0;
        }
    }
}
